    "@voltagent/libsql": "^2.0.2",
    "@voltagent/logger": "^2.0.2",
    "ai": "^6.0.5",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
