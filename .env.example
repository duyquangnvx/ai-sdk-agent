# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# LLM Provider Configuration
# Options: "openai-compatible", "google", "openai"
LLM_PROVIDER=openai-compatible

# OpenAI-Compatible Provider (OpenRouter, local LLM, etc.)
# Optional: Base URL for OpenAI-compatible API
# LLM_BASE_URL=https://api.openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3-30b-a3b:free
# Optional: API key for OpenAI-compatible provider
# LLM_API_KEY=your-api-key-here

# Gemini Provider
GEMINI_MODEL=gemini-2.5-flash
# Optional: Google API key for Gemini
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here

# OpenAI Provider
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI API key
# OPENAI_API_KEY=your-openai-api-key-here

